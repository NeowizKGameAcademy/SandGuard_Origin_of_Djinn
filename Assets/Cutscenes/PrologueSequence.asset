  m_Script: {fileID: 11500000, guid: c8fa1555afafc4544b1752509b9f8b70, type: 3}
  m_Name: PrologueSequence
  m_EditorClassIdentifier: Assembly-CSharp::SandGuard.Cutscenes.CutSceneSequence
  cuts:
  - title: "\uD3C9\uBC94\uD55C \uD558\uB8E8"
    body: "\uBC1C\uAD74 \uD604\uC7A5\uC758 \uD558\uB8E8\uB294 \uD574\uAC00 \uB728\uAE30
      \uC804\uC5D0 \uC2DC\uC791\uD574\uC11C, \uD574\uAC00 \uC9C4 \uB4A4\uC5D0\uC57C
      \uB05D\uB09C\uB2E4. \uC628\uC885\uC77C \uB3CC\uC744 \uB098\uB978 \uD0D3\uC5D0
      \uD314\uC774 \uBB35\uC9C1\uD588\uB2E4.\n\n\uB098\uB294 \uC7A0\uC2DC \uB3CC\uB354\uBBF8\uC5D0
      \uC549\uC544 \uC228\uC744 \uACE0\uB974\uBA70 \uBD89\uAC8C \uBB3C\uB4E0 \uD558\uB298\uC744
      \uBC14\uB77C\uBD24\uB2E4. \uC544\uB798\uC5D0\uC11C\uB294 \uC791\uC5C5\uC790\uB4E4\uC774
      \uB9C8\uC9C0\uB9C9 \uB3CC\uC744 \uC62E\uAE30\uB290\uB77C \uBD84\uC8FC\uD558\uB2E4.\n\n\u201C\uC870\uAE08\uB9CC
      \uB354 \uD558\uBA74 \uB05D\uB098\uACA0\uB124.\u201D \uD63C\uC7A3\uB9D0\uC744
      \uD558\uACE0\uB294, \uD574\uAC00 \uC0AC\uB9C9 \uB108\uBA38\uB85C \uB0B4\uB824\uAC00\uB294
      \uBAA8\uC2B5\uC744 \uC7A0\uC2DC \uB354 \uC9C0\uCF1C\uBD24\uB2E4."
    image: {fileID: 21300000, guid: 455398a6f07f0ec4d91f290eaad36c5c, type: 3}
    duration: 14
    panelX: 0.76
    panelY: 0.5
  - title: "\uC0AC\uB9C9\uC744 \uD5A5\uD55C \uB9C8\uC74C"
    body: "\uC2DC\uC120\uC744 \uB3CC\uB9AC\uC790 \uD604\uC7A5 \uB108\uBA38\uB85C
      \uBAA8\uB798 \uC5B8\uB355\uC774 \uB05D\uC5C6\uC774 \uD3BC\uCCD0\uC838 \uC788\uC5C8\uB2E4.
      \uB9E4\uC77C \uBCF4\uB294 \uD48D\uACBD\uC778\uB370\uB3C4, \uC800 \uB108\uBA38\uC5D0
      \uBB34\uC5C7\uC774 \uC788\uC744\uC9C0 \uAD81\uAE08\uD574\uC9C8 \uB54C\uAC00
      \uC788\uB2E4.\n\n\uC774\uACF3\uC5D0\uC11C \uBC1C\uACAC\uD55C \uAC83\uB4E4\uB3C4
      \uD55C\uB54C\uB294 \uBAA8\uB798 \uC544\uB798 \uC7A0\uB4E4\uC5B4 \uC788\uC5C8\uC73C\uB2C8\uAE4C.
      \uC544\uC9C1 \uC544\uBB34\uB3C4 \uCC3E\uC9C0 \uBABB\uD55C \uBB34\uC5B8\uAC00\uAC00
      \uC800 \uBA40\uB9AC\uC5D0 \uC788\uC744\uC9C0\uB3C4 \uBAA8\uB978\uB2E4.\n\n\uADF8\uB54C
      \uC544\uB798\uC5D0\uC11C \uB0B4 \uC774\uB984\uC744 \uBD80\uB974\uB294 \uC18C\uB9AC\uAC00
      \uB4E4\uB838\uB2E4. \uC0C1\uC0C1\uC740 \uC5EC\uAE30\uAE4C\uC9C0. \uB098\uB294
      \uC637\uC5D0 \uBB3B\uC740 \uBA3C\uC9C0\uB97C \uD138\uACE0 \uC77C\uC5B4\uB0AC\uB2E4."
    image: {fileID: 21300000, guid: d598f0efb27cb11448a5e1213504f360, type: 3}
    duration: 16
    panelX: 0.76
    panelY: 0.5
  - title: "\uB2E4\uC2DC \uC77C\uD130\uB85C"
    body: "\uC791\uC5C5\uC790\uB4E4\uC774 \uAC74\uB124\uB294 \uB3CC\uC744 \uBC1B\uC544
      \uACC4\uB2E8 \uCABD\uC73C\uB85C \uC62E\uACBC\uB2E4. \uBA87 \uBC88\uC744 \uC624\uB974\uB0B4\uB838\uB294\uC9C0
      \uBAA8\uB97C \uB9CC\uD07C \uC775\uC219\uD55C \uAE38\uC774\uC5C8\uB2E4.\n\n\uACE7
      \uC77C\uC774 \uB05D\uB098\uBA74 \uC26C\uB7EC \uAC08 \uC218 \uC788\uACA0\uC9C0.
      \uADF8\uB7F0 \uC0DD\uAC01\uC73C\uB85C \uB2E4\uC74C \uB3CC\uC744 \uC9D1\uC5B4
      \uB4E4\uC5C8\uC744 \uB54C, \uBC14\uB78C\uC774 \uAC11\uC790\uAE30 \uBAA8\uB798\uB97C
      \uC2E4\uC5B4 \uC654\uB2E4.\n\n\uCC98\uC74C\uC5D0\uB294 \uD3C9\uC18C\uC640 \uB2E4\uB974\uC9C0
      \uC54A\uC740 \uB3CC\uD48D\uC778 \uC904 \uC54C\uC558\uB2E4. \uD558\uC9C0\uB9CC
      \uB204\uAD70\uAC00 \uD558\uB298\uC744 \uAC00\uB9AC\uCF30\uACE0, \uBAA8\uB450\uC758
      \uC190\uAE38\uC774 \uBA48\uCDC4\uB2E4."
    image: {fileID: 21300000, guid: 41f307bdd1288f54abb4ca3168d5c7a9, type: 3}
    duration: 15
    panelX: 0.76
    panelY: 0.5
  - title: "\uAC11\uC791\uC2A4\uB7EC\uC6B4 \uBAA8\uB798\uD3ED\uD48D"
    body: "\uBA40\uB9AC \uC788\uB358 \uBAA8\uB798\uBC14\uB78C\uC774 \uBBFF\uC744
      \uC218 \uC5C6\uB294 \uC18D\uB3C4\uB85C \uB2E4\uAC00\uC654\uB2E4. \uC0AC\uB78C\uB4E4\uC774
      \uD53C\uD558\uB77C\uACE0 \uC678\uCE58\uB294 \uC21C\uAC04, \uBC14\uB78C\uC774
      \uD604\uC7A5\uC744 \uB36E\uCCE4\uB2E4.\n\n\uB098\uB294 \uB3CC\uC744 \uB0B4\uB824\uB193\uACE0
      \uBAB8\uC744 \uB0AE\uCDC4\uB2E4. \uBAA8\uB798\uAC00 \uC5BC\uAD74\uC744 \uB54C\uB9AC\uACE0,
      \uC870\uAE08 \uC804\uAE4C\uC9C0 \uBCF4\uC774\uB358 \uACC4\uB2E8\uB3C4 \uC21C\uC2DD\uAC04\uC5D0
      \uC0AC\uB77C\uC84C\uB2E4.\n\n\uB2E4\uB978 \uC0AC\uB78C\uB4E4\uC758 \uBAA9\uC18C\uB9AC\uB294
      \uB4E4\uB9AC\uB294\uB370 \uC5B4\uB290 \uCABD\uC778\uC9C0 \uC54C \uC218\uAC00
      \uC5C6\uB2E4. \uC77C\uB2E8 \uBC14\uB78C\uC744 \uD53C\uD574\uC57C \uD574. \uC190\uC73C\uB85C
      \uC55E\uC744 \uB354\uB4EC\uC73C\uBA70 \uAC00\uAE4C\uC6B4 \uB3CC\uBCBD \uCABD\uC73C\uB85C
      \uBAB8\uC744 \uC62E\uACBC\uB2E4."
    image: {fileID: 21300000, guid: fde14383d43871540895a28c028163cf, type: 3}
    duration: 18
    panelX: 0.76
    panelY: 0.5
  - title: "\uBAA8\uB798 \uC18D\uC5D0\uC11C \uBC1C\uACAC\uD55C \uB7A8\uD504"
    body: "\uBCBD\uC744 \uCC3E\uC73C\uB824 \uBED7\uC740 \uC190\uB05D\uC5D0 \uB3CC\uC774
      \uC544\uB2CC \uBB3C\uAC74\uC774 \uAC78\uB838\uB2E4. \uBAA8\uB798\uC5D0 \uBC18\uCBE4
      \uBB3B\uD600 \uC788\uB358 \uC791\uC740 \uB7A8\uD504\uC600\uB2E4.\n\n\uC65C
      \uC774\uB7F0 \uACF3\uC5D0 \uC788\uB294\uC9C0 \uC758\uC544\uD588\uC9C0\uB9CC,
      \uB2E4\uC2DC \uB0A0\uC544\uAC00\uC9C0 \uC54A\uB3C4\uB85D \uB450 \uC190\uC73C\uB85C
      \uAC10\uC2F8 \uC950\uC5C8\uB2E4. \uC624\uB798\uB41C \uD45C\uBA74\uC744 \uD6D1\uB358
      \uC190\uAC00\uB77D \uC544\uB798\uB85C \uD76C\uBBF8\uD55C \uD478\uB978\uBE5B\uC774
      \uBE44\uCCE4\uB2E4.\n\n\uCC29\uAC01\uC778\uAC00 \uC2F6\uC5B4 \uB208\uC744 \uAC00\uAE4C\uC774
      \uAC00\uC838\uAC14\uB2E4. \uB7A8\uD504\uC5D0 \uC0C8\uACA8\uC9C4 \uBB38\uC591\uC774,
      \uBAA8\uB798\uBC14\uB78C \uC18D\uC5D0\uC11C\uB3C4 \uBD84\uBA85\uD558\uAC8C
      \uBE5B\uB098\uACE0 \uC788\uC5C8\uB2E4."
    image: {fileID: 21300000, guid: 106251cc0770bae4bbbabd18bb26ac1b, type: 3}
    duration: 17
    panelX: 0.76
    panelY: 0.5
  - title: "\uD3ED\uD48D \uC18D\uC758 \uC774\uC815\uD45C"
    body: "\uBE5B\uC740 \uC870\uAE08\uC529 \uBC1D\uC544\uC9C0\uB354\uB2C8 \uB7A8\uD504\uC758
      \uC8FC\uB465\uC774\uB85C \uBAA8\uC5EC\uB4E4\uC5C8\uB2E4. \uB2E4\uC74C \uC21C\uAC04,
      \uC2E4\uCC98\uB7FC \uAC00\uB290\uB2E4\uB780 \uBE5B\uC904\uAE30\uAC00 \uD3ED\uD48D
      \uC18D\uC73C\uB85C \uBED7\uC5B4 \uB098\uAC14\uB2E4.\n\n\uBC14\uB78C\uC740 \uC5EC\uC804\uD788
      \uAC70\uC13C\uB370 \uBE5B\uC740 \uD769\uC5B4\uC9C0\uC9C0 \uC54A\uB294\uB2E4.
      \uC5B4\uB514\uB97C \uAC00\uB9AC\uD0A4\uB294 \uAC78\uAE4C?\n\n\uB098\uB294 \uB7A8\uD504\uB97C
      \uB4E0 \uCC44 \uADF8 \uBC29\uD5A5\uC744 \uBC14\uB77C\uBD24\uB2E4. \uD718\uBAB0\uC544\uCE58\uB294
      \uBAA8\uB798 \uB108\uBA38\uB85C \uAC70\uB300\uD55C \uC724\uACFD\uC774 \uC5B8\uB73B
      \uBCF4\uC600\uB2E4\uAC00 \uB2E4\uC2DC \uC0AC\uB77C\uC84C\uB2E4."
    image: {fileID: 21300000, guid: 023be0bc57b22414885bbe46784d9f7f, type: 3}
    duration: 15
    panelX: 0.76
    panelY: 0.5
  - title: "\uB4DC\uB7EC\uB09C \uC2E0\uC804"
    body: "\uBC14\uB78C\uC774 \uC7A6\uC544\uB4E4\uBA74\uC11C \uC2DC\uC57C\uAC00 \uC870\uAE08\uC529
      \uD2B8\uC600\uB2E4. \uD76C\uBBF8\uD55C \uC724\uACFD\uC740 \uACC4\uB2E8\uC774\uC5C8\uACE0,
      \uADF8 \uC704\uB85C \uAC70\uB300\uD55C \uD53C\uB77C\uBBF8\uB4DC \uC2E0\uC804\uC774
      \uBAA8\uC2B5\uC744 \uB4DC\uB7EC\uB0C8\uB2E4.\n\n\uB098\uB294 \uBBFF\uAE30\uC9C0
      \uC54A\uC544 \uC8FC\uBCC0\uC744 \uB3CC\uC544\uBD24\uB2E4. \uC870\uAE08 \uC804\uAE4C\uC9C0
      \uC774\uACF3\uC5D0\uB294 \uBAA8\uB798\uBC14\uB78C\uBC16\uC5D0 \uBCF4\uC774\uC9C0
      \uC54A\uC558\uB294\uB370.\n\n\uC2E0\uC804 \uC815\uC0C1\uC5D0\uC11C \uD478\uB978\uBE5B\uC774
      \uBC18\uC9DD\uC774\uC790 \uC190\uC548\uC758 \uB7A8\uD504\uAC00 \uB2E4\uC2DC
      \uBE5B\uB0AC\uB2E4. \uC6B0\uC5F0\uD788 \uBC1C\uACAC\uD55C \uC774 \uB7A8\uD504\uC640
      \uC800 \uC2E0\uC804\uC740 \uBB34\uC2A8 \uAD00\uACC4\uC77C\uAE4C?\n\n\uB098\uB294
      \uD55C\uB3D9\uC548 \uADF8 \uC790\uB9AC\uC5D0 \uC11C\uC11C, \uBE5B\uC774 \uAC00\uB9AC\uD0A8
      \uACF3\uC744 \uC62C\uB824\uB2E4\uBD24\uB2E4."
    image: {fileID: 21300000, guid: bcaa229370253104f895ffce33d61c0b, type: 3}
    duration: 20
    panelX: 0.24
    panelY: 0.5
