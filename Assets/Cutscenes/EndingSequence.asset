  m_Script: {fileID: 11500000, guid: c8fa1555afafc4544b1752509b9f8b70, type: 3}
  m_Name: EndingSequence
  m_EditorClassIdentifier: Assembly-CSharp::SandGuard.Cutscenes.CutSceneSequence
  cuts:
  - title: "\uCD5C\uD6C4\uC758 \uACF5\uBC29"
    body: "\uB05D\uC5C6\uC774 \uBAB0\uB824\uB4E4\uB358 \uB3C4\uC801\uB4E4\uACFC\uC758
      \uC2F8\uC6C0\uC740 \uC5B4\uB290\uC0C8 \uC2E0\uC804 \uC911\uC2EC\uBD80\uAE4C\uC9C0
      \uBC88\uC838 \uC788\uC5C8\uB2E4.\n\n\uC218\uD638\uD0D1\uC5D0\uC11C\uB294 \uBD88\uAE38\uACFC
      \uBC88\uAC1C\uAC00 \uC3DF\uC544\uC84C\uACE0, \uAE68\uC5B4\uB09C \uC544\uB204\uBE44\uC2A4\uC640
      \uD574\uACE8 \uBCD1\uC0AC\uB4E4\uC740 \uBB34\uB108\uC9C4 \uD1B5\uB85C\uC640
      \uACC4\uB2E8\uC744 \uC9C0\uD0A4\uBA70 \uCE68\uC785\uC790\uB4E4\uC744 \uB9C9\uC544\uC130\uB2E4.
      \uB3C4\uC801\uB4E4\uB3C4 \uBB3C\uB7EC\uC11C\uC9C0 \uC54A\uC558\uB2E4. \uC0AC\uBC29\uC5D0\uC11C
      \uC2E0\uC804\uC758 \uBCBD\uC744 \uAE30\uC5B4\uC624\uB974\uACE0, \uC218\uD638\uC790\uB4E4\uC744
      \uBC00\uC5B4\uB0B4\uBA70 \uB9C8\uC11D\uC744 \uD5A5\uD574 \uC804\uC9C4\uD588\uB2E4.\n\n\uB098\uB294
      \uB7A8\uD504\uC5D0\uC11C \uB04C\uC5B4\uB0B8 \uB9C8\uB825\uC73C\uB85C \uC804\uC7A5\uC744
      \uC624\uAC00\uBA70 \uBB34\uB108\uC9C0\uB294 \uBC29\uC5B4\uC120\uC744 \uC9C0\uCF1C\uB0C8\uB2E4.
      \uCC98\uC74C\uC5D0\uB294 \uB2E4\uB8E8\uB294 \uAC83\uC870\uCC28 \uC5B4\uB824\uC6E0\uB358
      \uD798\uC774 \uC774\uC81C\uB294 \uB0B4 \uC190\uC9D3\uC744 \uB530\uB77C \uC801\uB4E4\uC744
      \uD5A5\uD574 \uBED7\uC5B4 \uB098\uAC14\uB2E4."
    image: {fileID: 21300000, guid: 5a29b04f41ac7434ea7f2ef3d9392452, type: 3}
    duration: 17
    panelX: 0.77
    panelY: 0.5
  - title: "\uB05D\uB0AC\uB2E4\uACE0 \uBBFF\uC5C8\uB358 \uC2F8\uC6C0"
    body: "\uACB0\uAD6D, \uB9C8\uC9C0\uB9C9 \uB0A8\uC740 \uB3C4\uC801\uC774 \uC4F0\uB7EC\uC9C0\uC790
      \uC2E0\uC804\uC744 \uB4A4\uB36E\uC5C8\uB358 \uD568\uC131\uC774 \uBA4E\uC5C8\uB2E4.\n\n\uCD5C\uC885
      \uBCF4\uC2A4\uAC00 \uD798\uC744 \uC783\uACE0 \uBB34\uB108\uC84C\uACE0, \uC0B4\uC544\uB0A8\uC740
      \uB3C4\uC801\uB4E4\uC740 \uBB34\uAE30\uB97C \uBC84\uB9B0 \uCC44 \uC0AC\uB9C9\uC73C\uB85C
      \uB2EC\uC544\uB0AC\uB2E4. \uACF3\uACF3\uC5D0 \uBD80\uC11C\uC9C4 \uC218\uD638\uD0D1\uACFC
      \uBB34\uB108\uC9C4 \uBCBD\uC774 \uB0A8\uC558\uC9C0\uB9CC, \uC2E0\uC804 \uC911\uC559\uC758
      \uB9C8\uC11D\uC740 \uC5EC\uC804\uD788 \uC790\uB9AC\uB97C \uC9C0\uD0A4\uACE0
      \uC788\uC5C8\uB2E4.\n\n\uC628\uBAB8\uC5D0 \uD798\uC774 \uB0A8\uC544 \uC788\uC9C0
      \uC54A\uC558\uB2E4. \uADF8\uB798\uB3C4 \uB05D\uAE4C\uC9C0 \uB9C8\uC11D\uC744
      \uC9C0\uCF1C\uB0C8\uB2E4\uB294 \uC0AC\uC2E4\uC5D0 \uC548\uB3C4\uD558\uBA70
      \uAC70\uCE5C \uC228\uC744 \uB0B4\uC26C\uC5C8\uB2E4.\n\n\uC774\uC81C \uBAA8\uB4E0
      \uAC83\uC774 \uB05D\uB0AC\uB2E4\uACE0 \uC0DD\uAC01\uD588\uB2E4.\n\n\uADF8\uB7EC\uB098
      \uC7A0\uC2DC \uD6C4, \uC2E0\uC804 \uC544\uB798\uC5D0\uC11C \uBD88\uAE38\uD55C
      \uC9C4\uB3D9\uC774 \uC6B8\uB824 \uD37C\uC84C\uB2E4."
    image: {fileID: 21300000, guid: be774bc4c0db0c84281078ec9ede1d0d, type: 3}
    duration: 18
    panelX: 0.77
    panelY: 0.5
  - title: "\uD1B5\uC81C\uB97C \uC783\uC740 \uB9C8\uC11D"
    body: "\uB9C8\uC11D\uC758 \uD45C\uBA74\uC5D0 \uAC80\uC740 \uADE0\uC5F4\uC774
      \uBC88\uC9C0\uAE30 \uC2DC\uC791\uD588\uB2E4.\n\n\uD478\uB978\uBE5B \uC0AC\uC774\uB85C
      \uD0C1\uD558\uACE0 \uBD89\uC740 \uB9C8\uB825\uC774 \uC0C8\uC5B4 \uB098\uC654\uACE0,
      \uACF5\uC911\uC744 \uB9F4\uB3CC\uB358 \uD30C\uD3B8\uB4E4\uC774 \uAC70\uCE60\uAC8C
      \uD754\uB4E4\uB838\uB2E4. \uB098\uB294 \uB7A8\uD504\uC758 \uD798\uC73C\uB85C
      \uB9C8\uC11D\uC744 \uC9C4\uC815\uC2DC\uD0A4\uB824 \uD588\uC9C0\uB9CC, \uC774\uBBF8
      \uB0B4\uBD80\uC5D0 \uC313\uC778 \uB9C8\uB825\uC740 \uD1B5\uC81C\uD560 \uC218
      \uC788\uB294 \uC218\uC900\uC744 \uB118\uC5B4\uC120 \uB4A4\uC600\uB2E4.\n\n\uB3C4\uC801\uB4E4\uC774
      \uB9C8\uC11D\uC744 \uCC28\uC9C0\uD558\uAE30 \uC704\uD574 \uAC00\uD55C \uACF5\uACA9\uACFC
      \uB0B4\uAC00 \uB04C\uC5B4\uB0B8 \uD798\uC774 \uC11C\uB85C \uB4A4\uC5C9\uCF1C
      \uC788\uC5C8\uB2E4. \uC624\uB7AB\uB3D9\uC548 \uC7A0\uB4E4\uC5B4 \uC788\uB358
      \uB9C8\uC11D\uC740 \uADF8 \uBAA8\uB4E0 \uD798\uC744 \uACAC\uB514\uC9C0 \uBABB\uD558\uACE0
      \uBB34\uB108\uC9C0\uACE0 \uC788\uC5C8\uB2E4.\n\n\uADE0\uC5F4\uC774 \uB9C8\uC11D
      \uC804\uCCB4\uB97C \uB4A4\uB36E\uC740 \uC21C\uAC04, \uAC70\uB300\uD55C \uD3ED\uBC1C\uACFC
      \uD568\uAED8 \uC624\uC5FC\uB41C \uB9C8\uB825\uC774 \uC2E0\uC804 \uBC16\uC73C\uB85C
      \uC3DF\uC544\uC838 \uB098\uAC14\uB2E4."
    image: {fileID: 21300000, guid: a478010230a259e44b0836aedf3be27d, type: 3}
    duration: 18
    panelX: 0.77
    panelY: 0.5
  - title: "\uC0AC\uB9C9\uC744 \uB4A4\uB36E\uC740 \uC624\uC5FC"
    body: "\uAC80\uBD89\uC740 \uB9C8\uB825\uC740 \uD3ED\uD48D\uC774 \uB418\uC5B4
      \uC0AC\uB9C9 \uC804\uC5ED\uC73C\uB85C \uD37C\uC838 \uB098\uAC14\uB2E4.\n\n\uC2E0\uC804
      \uC8FC\uBCC0\uC758 \uBAA8\uB798\uB294 \uAC80\uAC8C \uBB3C\uB4E4\uC5C8\uACE0,
      \uB9C8\uB825\uC5D0 \uD729\uC4F8\uB9B0 \uC0DD\uBA85\uB4E4\uC740 \uC774\uC131\uC744
      \uC783\uC740 \uCC44 \uC11C\uB85C\uB97C \uACF5\uACA9\uD558\uAE30 \uC2DC\uC791\uD588\uB2E4.
      \uBA54\uB9C8\uB978 \uB545\uC5D0\uC11C \uC0B4\uC544\uAC00\uB358 \uC9D0\uC2B9\uB4E4\uB9C8\uC800
      \uD749\uD3EC\uD55C \uAD34\uBB3C\uB85C \uBCC0\uD574 \uAC14\uB2E4.\n\n\uBA40\uB9AC
      \uBC14\uB77C\uBCF8 \uD558\uB298 \uC544\uB798\uC5D0\uB294 \uB0B4\uAC00 \uC0B4\uB358
      \uB9C8\uC744\uACFC \uD53C\uB77C\uBBF8\uB4DC \uBC1C\uAD74 \uD604\uC7A5\uC774
      \uC788\uC5C8\uB2E4.\n\n\uC624\uC5FC\uB41C \uD3ED\uD48D\uC740 \uADF8\uACF3\uAE4C\uC9C0
      \uC9D1\uC5B4\uC0BC\uD0A4\uACE0 \uC788\uC5C8\uB2E4. \uD568\uAED8 \uB3CC\uC744
      \uB098\uB974\uB358 \uC0AC\uB78C\uB4E4\uACFC \uB9E4\uC77C \uC778\uC0AC\uB97C
      \uB098\uB204\uB358 \uC774\uC6C3\uB4E4\uC774 \uAC80\uC740 \uB9C8\uB825 \uC18D\uC5D0\uC11C
      \uACE0\uD1B5\uBC1B\uB294 \uBAA8\uC2B5\uC774 \uBCF4\uC600\uB2E4.\n\n\uB9C8\uC11D\uC744
      \uC9C0\uD0A4\uBA74 \uBAA8\uB450\uB97C \uAD6C\uD560 \uC218 \uC788\uC744 \uAC70\uB77C
      \uBBFF\uC5C8\uB2E4. \uADF8\uB7EC\uB098 \uB0B4\uAC00 \uAE68\uC6B4 \uD798\uC740
      \uC774\uC81C \uB0B4\uAC00 \uC0AC\uB791\uD588\uB358 \uBAA8\uB4E0 \uAC83\uC744
      \uD30C\uAD34\uD558\uACE0 \uC788\uC5C8\uB2E4."
    image: {fileID: 21300000, guid: 3a7a0d28c5e23284d8d0ce7438d32d67, type: 3}
    duration: 19
    panelX: 0.77
    panelY: 0.5
  - title: "\uBD09\uC778\uC758 \uB300\uAC00"
    body: "\uAE09\uBC15\uD55C \uC0C1\uD669, \uC5B4\uB5BB\uAC8C \uD574\uC57C\uD560\uAE4C
      \uACE0\uBBFC\uD558\uB358 \uC640\uC911, \uB7A8\uD504\uAC00 \uB5A0\uC62C\uB790\uB2E4.
      \uADF8\uB798, \uB9C8\uB825\uC744 \uB2F4\uC544\uB458\uC218\uC788\uB294 \uC774
      \uB7A8\uD504\uC5D0 \uBAA8\uB4E0 \uD758\uB7EC\uB098\uC624\uB294 \uBAA8\uB4E0
      \uB9C8\uB825\uC744 \uB2F4\uC544\uB123\uC790. \uD558\uC9C0\uB9CC \uB7A8\uD504\uC5D0
      \uB9C8\uB825\uC744 \uAC00\uB450\uB294 \uAC83\uB9CC\uC73C\uB85C\uB294 \uBD80\uC871\uD588\uB2E4.\n\n\uD3ED\uC8FC\uD558\uB294
      \uD798\uC774 \uB2E4\uC2DC \uBC16\uC73C\uB85C \uD758\uB7EC\uB098\uC624\uC9C0
      \uC54A\uAC8C \uD558\uB824\uBA74, \uB7A8\uD504 \uC548\uC5D0\uC11C \uADF8 \uD798\uC744
      \uBD99\uB4E4\uC5B4 \uB458 \uC601\uD63C\uC774 \uD544\uC694\uD588\uB2E4. \uC601\uC6D0\uD788
      \uB5A0\uB0A0 \uC218 \uC5C6\uB294 \uB2FB\uC774 \uB418\uC5B4 \uB9C8\uB825\uC744
      \uC5B5\uB204\uB97C \uC874\uC7AC\uAC00 \uC788\uC5B4\uC57C \uD588\uB2E4."
    image: {fileID: 21300000, guid: ccbdddf7a6d91174d959931a43b2f050, type: 3}
    duration: 16
    panelX: 0.77
    panelY: 0.5
  - title: "\uB9C8\uC9C0\uB9C9\uC73C\uB85C \uBC14\uB77C\uBCF8 \uC0AC\uB9C9"
    body: "\uB098\uB294 \uC2E0\uC804 \uAC00\uC7A5 \uB192\uC740 \uACF3\uC5D0 \uC62C\uB77C
      \uC0AC\uB9C9\uC744 \uBC14\uB77C\uBD24\uB2E4.\n\n\uC5B4\uB290\uC0C8 \uD574\uAC00
      \uC800\uBB3C\uACE0, \uBC24\uD558\uB298\uC5D0\uB294 \uC218\uC5C6\uC774 \uB9CE\uC740
      \uBCC4\uACFC \uC740\uD558\uC218\uAC00 \uD3BC\uCCD0\uC838 \uC788\uC5C8\uB2E4.
      \uB2EC\uBE5B\uC744 \uBC1B\uC740 \uBAA8\uB798\uC5B8\uB355\uC740 \uBC14\uB78C\uC744
      \uB530\uB77C \uB05D\uC5C6\uC774 \uC774\uC5B4\uC84C\uACE0, \uADF8 \uB108\uBA38\uC5D0\uB294
      \uB0B4\uAC00 \uD3C9\uC0DD \uBC14\uB77C\uBCF4\uBA70 \uB3D9\uACBD\uD588\uB358
      \uC790\uC720\uB85C\uC6B4 \uC138\uC0C1\uC774 \uC788\uC5C8\uB2E4.\n\n\uC5B8\uC820\uAC00\uB294
      \uC800 \uBAA8\uB798\uC5B8\uB355 \uB108\uBA38\uAE4C\uC9C0 \uAC00 \uBCF4\uACE0
      \uC2F6\uC5C8\uB2E4. \uB204\uAD6C\uC758 \uBA85\uB839\uB3C4 \uBC1B\uC9C0 \uC54A\uACE0,
      \uBC1C\uAE38\uC774 \uB2FF\uB294 \uACF3\uC774\uB77C\uBA74 \uC5B4\uB514\uB4E0
      \uB5A0\uB098\uB294 \uC0B6\uC744 \uAFC8\uAFE8\uB2E4.\n\n\uADF8\uAC83\uC774 \uB0B4\uAC00
      \uBC14\uB77C\uB358 \uC790\uC720\uC600\uB2E4.\n\n\uB098\uB294 \uB208\uC744 \uAC10\uACE0
      \uC0AC\uB9C9\uC758 \uBC14\uB78C\uC744 \uB9C8\uC9C0\uB9C9\uC73C\uB85C \uB290\uAF08\uB2E4.
      \uADF8\uB9AC\uACE0 \uB2E4\uC2DC \uB208\uC744 \uB5B4\uC744 \uB54C, \uBB34\uC5C7\uC744
      \uD574\uC57C \uD558\uB294\uC9C0 \uC774\uBBF8 \uC54C\uACE0 \uC788\uC5C8\uB2E4."
    image: {fileID: 21300000, guid: ae8c67363a23e094782c4e7b4d448ae1, type: 3}
    duration: 18
    panelX: 0.77
    panelY: 0.5
  - title: "\uC790\uC720\uB97C \uC704\uD55C \uC120\uD0DD"
    body: "\uB0B4\uAC00 \uC790\uC720\uB97C \uD3EC\uAE30\uD558\uBA74, \uB2E4\uB978
      \uC774\uB4E4\uC758 \uC790\uC720\uB97C \uC9C0\uD0AC \uC218 \uC788\uB2E4.\n\n\uB9C8\uC744\uC758
      \uC0AC\uB78C\uB4E4\uC774 \uB2E4\uC2DC \uD3C9\uBC94\uD55C \uD558\uB8E8\uB97C
      \uC0B4\uC544\uAC00\uACE0, \uC544\uC774\uB4E4\uC774 \uB450\uB824\uC6C0 \uC5C6\uC774
      \uC0AC\uB9C9\uC744 \uB2EC\uB9B4 \uC218 \uC788\uB2E4. \uC624\uC5FC\uB41C \uB9C8\uB825\uC5D0
      \uD729\uC4F8\uB9B0 \uC0DD\uBA85\uB4E4\uB3C4 \uBCF8\uB798\uC758 \uBAA8\uC2B5\uC744
      \uB418\uCC3E\uC744 \uAC83\uC774\uB2E4.\n\n\uB450\uB835\uC9C0 \uC54A\uB2E4\uBA74
      \uAC70\uC9D3\uB9D0\uC774\uC5C8\uB2E4.\n\n\uD55C \uBC88 \uB7A8\uD504 \uC548\uC73C\uB85C
      \uB4E4\uC5B4\uAC00\uBA74 \uB2E4\uC2DC\uB294 \uC774 \uD558\uB298\uC744 \uBCFC
      \uC218 \uC5C6\uB2E4. \uADF8\uD1A0\uB85D \uC0AC\uB791\uD588\uB358 \uC0AC\uB9C9\uC744
      \uB0B4 \uBC1C\uB85C \uAC78\uC744 \uC218\uB3C4 \uC5C6\uACE0, \uB204\uAD6C\uC640\uB3C4
      \uAC19\uC740 \uC2DC\uAC04\uC744 \uC0B4\uC544\uAC08 \uC218 \uC5C6\uAC8C \uB41C\uB2E4.\n\n\uD558\uC9C0\uB9CC
      \uB0B4\uAC00 \uC2DC\uC791\uD55C \uC77C\uC774\uC5C8\uB2E4. \uC774\uC81C\uB294
      \uB0B4\uAC00 \uB05D\uB0B4\uC57C \uD588\uB2E4.\n\n\uB098\uB294 \uB7A8\uD504\uB97C
      \uAC00\uC2B4 \uAC00\uAE4C\uC774 \uB04C\uC5B4\uC548\uACE0 \uC18C\uC6D0\uC744
      \uBE4C\uC5C8\uB2E4.\n\n\u201C\uC774 \uC0AC\uB9C9\uC5D0 \uC0B4\uC544\uAC00\uB294
      \uBAA8\uB450\uC5D0\uAC8C \uC790\uC720\uB97C \uB3CC\uB824\uC918.\u201D"
    image: {fileID: 21300000, guid: f20197722e9c3494bb3c019cff0da44e, type: 3}
    duration: 20
    panelX: 0.77
    panelY: 0.5
  - title: "\uC601\uC6D0\uD55C \uBD09\uC778"
    body: "\uB7A8\uD504\uC5D0\uC11C \uB208\uBD80\uC2E0 \uD478\uB978\uBE5B\uC774 \uD130\uC838
      \uB098\uC654\uB2E4.\n\n\uC0AC\uB9C9\uC744 \uB4A4\uB36E\uC5C8\uB358 \uC624\uC5FC\uB41C
      \uB9C8\uB825\uC774 \uD750\uB984\uC744 \uBC14\uAFB8\uC5B4 \uC2E0\uC804\uC73C\uB85C
      \uB3CC\uC544\uC624\uAE30 \uC2DC\uC791\uD588\uB2E4. \uB9C8\uC744\uACFC \uBC1C\uAD74
      \uD604\uC7A5, \uAC80\uAC8C \uBB3C\uB4E0 \uBAA8\uB798\uC640 \uC0DD\uBA85\uB4E4\uC5D0\uAC8C\uC11C
      \uBE60\uC838\uB098\uC628 \uB9C8\uB825\uC774 \uAC70\uB300\uD55C \uC18C\uC6A9\uB3CC\uC774\uB97C
      \uC774\uB8E8\uBA70 \uB7A8\uD504 \uC548\uC73C\uB85C \uBE68\uB824 \uB4E4\uC5B4\uAC14\uB2E4.\n\n\uB0B4
      \uBAB8\uB3C4 \uC11C\uC11C\uD788 \uBE5B\uC73C\uB85C \uBCC0\uD574 \uAC14\uB2E4.\n\n\uC190\uB05D\uC774
      \uC0AC\uB77C\uC9C0\uACE0, \uBC1C\uBC11\uC758 \uAC10\uAC01\uC774 \uD76C\uBBF8\uD574\uC84C\uB2E4.
      \uB9C8\uC9C0\uB9C9 \uC21C\uAC04\uAE4C\uC9C0 \uB208\uC55E\uC758 \uC0AC\uB9C9\uC744
      \uBC14\uB77C\uBCF4\uB824 \uD588\uC9C0\uB9CC, \uC138\uC0C1\uC740 \uC810\uCC28
      \uD478\uB978\uBE5B \uC18D\uC5D0 \uC7A0\uACBC\uB2E4.\n\n\uB9C8\uCE68\uB0B4 \uB9C8\uC11D\uC758
      \uD3ED\uC8FC\uB294 \uBA48\uCDC4\uACE0, \uC624\uC5FC\uB41C \uB9C8\uB825\uC740
      \uB098\uC758 \uC601\uD63C\uACFC \uD568\uAED8 \uB7A8\uD504 \uC548\uC5D0 \uBD09\uC778\uB418\uC5C8\uB2E4.\n\n\uC0AC\uB9C9\uC5D0\uB294
      \uB2E4\uC2DC \uACE0\uC694\uD55C \uBC14\uB78C\uC774 \uBD88\uAE30 \uC2DC\uC791\uD588\uB2E4."
    image: {fileID: 21300000, guid: 0c50dad5c7d1c8a42ad21b359bfa9824, type: 3}
    duration: 19
    panelX: 0.77
    panelY: 0.5
  - title: "\uC0AC\uB9C9\uC758 \uC218\uD638\uC790"
    body: "\uD3ED\uD48D\uC774 \uC0AC\uB77C\uC9C4 \uBAA8\uB798\uBC2D \uC704\uC5D0\uB294
      \uB0A1\uC740 \uB7A8\uD504 \uD558\uB098\uB9CC\uC774 \uB0A8\uC558\uB2E4.\n\uC624\uC5FC\uB41C
      \uB9C8\uB825\uC774 \uAC77\uD788\uC790 \uC0AC\uB9C9\uC740 \uBCF8\uB798\uC758
      \uBE5B\uC744 \uB418\uCC3E\uC558\uACE0, \uC0AC\uB78C\uB4E4\uC758 \uC77C\uC0C1\uC5D0\uB3C4
      \uD3C9\uD654\uAC00 \uB3CC\uC544\uC654\uB2E4.\n\uAE34 \uC2DC\uAC04\uC774 \uD750\uB974\uBA70
      \uC2E0\uC804\uC740 \uB2E4\uC2DC \uBAA8\uB798 \uC544\uB798 \uBB3B\uD614\uACE0,
      \uADF8\uB0A0\uC758 \uC774\uC57C\uAE30\uB3C4 \uD76C\uBBF8\uD55C \uC804\uC124\uC774
      \uB418\uC5B4 \uAC14\uB2E4.\n\uD558\uC9C0\uB9CC \uB7A8\uD504 \uC548\uC5D0\uC11C
      \uB098\uC758 \uC758\uC2DD\uC740 \uC0AC\uB77C\uC9C0\uC9C0 \uC54A\uC558\uB2E4.\n\uB05D\uC5C6\uB294
      \uC5B4\uB460 \uC18D\uC5D0\uC11C \uBC24\uD558\uB298\uC758 \uC740\uD558\uC218\uC640
      \uBC14\uB78C\uC774 \uC2A4\uCE58\uB358 \uBAA8\uB798\uC5B8\uB355\uC744 \uADF8\uB9AC\uC6CC\uD558\uBA70,
      \uBD09\uC778\uB41C \uB9C8\uB825\uC774 \uB2E4\uC2DC \uAE68\uC5B4\uB098\uC9C0
      \uC54A\uB3C4\uB85D \uBD99\uB4E4\uC5C8\uB2E4.\n\uADF8\uB9AC\uACE0 \uC5B8\uC820\uAC00
      \uB204\uAD70\uAC00 \uC774 \uB7A8\uD504\uB97C \uBC1C\uACAC\uD574, \uB098\uB97C
      \uB2E4\uC2DC \uC138\uC0C1 \uBC16\uC73C\uB85C \uBD88\uB7EC\uC8FC\uAE30\uB97C
      \uAE30\uB2E4\uB838\uB2E4.\n\uADF8\uB807\uAC8C \uD55C \uC778\uAC04\uC758 \uB9C8\uC9C0\uB9C9
      \uC18C\uC6D0\uACFC \uD76C\uC0DD\uC73C\uB85C, \uC0AC\uB9C9\uC744 \uC218\uD638\uD558\uB294
      \uCD5C\uCD08\uC758 \uC9C0\uB2C8\uAC00 \uD0C4\uC0DD\uD588\uB2E4."
    image: {fileID: 21300000, guid: 39dbe6e84a48fdb4b96bd93e3f679af1, type: 3}
    duration: 21
    panelX: 0.77
    panelY: 0.5
