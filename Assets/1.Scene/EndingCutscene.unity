  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\uB05D\uC5C6\uC774 \uBAB0\uB824\uB4E4\uB358 \uB3C4\uC801\uB4E4\uACFC\uC758
    \uC2F8\uC6C0\uC740 \uC5B4\uB290\uC0C8 \uC2E0\uC804 \uC911\uC2EC\uBD80\uAE4C\uC9C0
    \uBC88\uC838 \uC788\uC5C8\uB2E4.\n\n\uC218\uD638\uD0D1\uC5D0\uC11C\uB294 \uBD88\uAE38\uACFC
    \uBC88\uAC1C\uAC00 \uC3DF\uC544\uC84C\uACE0, \uAE68\uC5B4\uB09C \uC544\uB204\uBE44\uC2A4\uC640
    \uD574\uACE8 \uBCD1\uC0AC\uB4E4\uC740 \uBB34\uB108\uC9C4 \uD1B5\uB85C\uC640 \uACC4\uB2E8\uC744
    \uC9C0\uD0A4\uBA70 \uCE68\uC785\uC790\uB4E4\uC744 \uB9C9\uC544\uC130\uB2E4. \uB3C4\uC801\uB4E4\uB3C4
    \uBB3C\uB7EC\uC11C\uC9C0 \uC54A\uC558\uB2E4. \uC0AC\uBC29\uC5D0\uC11C \uC2E0\uC804\uC758
    \uBCBD\uC744 \uAE30\uC5B4\uC624\uB974\uACE0, \uC218\uD638\uC790\uB4E4\uC744 \uBC00\uC5B4\uB0B4\uBA70
    \uB9C8\uC11D\uC744 \uD5A5\uD574 \uC804\uC9C4\uD588\uB2E4.\n\n\uB098\uB294 \uB7A8\uD504\uC5D0\uC11C
    \uB04C\uC5B4\uB0B8 \uB9C8\uB825\uC73C\uB85C \uC804\uC7A5\uC744 \uC624\uAC00\uBA70
    \uBB34\uB108\uC9C0\uB294 \uBC29\uC5B4\uC120\uC744 \uC9C0\uCF1C\uB0C8\uB2E4. \uCC98\uC74C\uC5D0\uB294
    \uB2E4\uB8E8\uB294 \uAC83\uC870\uCC28 \uC5B4\uB824\uC6E0\uB358 \uD798\uC774 \uC774\uC81C\uB294
    \uB0B4 \uC190\uC9D3\uC744 \uB530\uB77C \uC801\uB4E4\uC744 \uD5A5\uD574 \uBED7\uC5B4
    \uB098\uAC14\uB2E4."
