      m_Calls: []
  m_text: "\uBC1C\uAD74 \uD604\uC7A5\uC758 \uD558\uB8E8\uB294 \uD574\uAC00 \uB728\uAE30
    \uC804\uC5D0 \uC2DC\uC791\uD574\uC11C, \uD574\uAC00 \uC9C4 \uB4A4\uC5D0\uC57C
    \uB05D\uB09C\uB2E4. \uC628\uC885\uC77C \uB3CC\uC744 \uB098\uB978 \uD0D3\uC5D0
    \uD314\uC774 \uBB35\uC9C1\uD588\uB2E4.\n\n\uB098\uB294 \uC7A0\uC2DC \uB3CC\uB354\uBBF8\uC5D0
    \uC549\uC544 \uC228\uC744 \uACE0\uB974\uBA70 \uBD89\uAC8C \uBB3C\uB4E0 \uD558\uB298\uC744
    \uBC14\uB77C\uBD24\uB2E4. \uC544\uB798\uC5D0\uC11C\uB294 \uC791\uC5C5\uC790\uB4E4\uC774
    \uB9C8\uC9C0\uB9C9 \uB3CC\uC744 \uC62E\uAE30\uB290\uB77C \uBD84\uC8FC\uD558\uB2E4.\n\n\u201C\uC870\uAE08\uB9CC
    \uB354 \uD558\uBA74 \uB05D\uB098\uACA0\uB124.\u201D \uD63C\uC7A3\uB9D0\uC744
    \uD558\uACE0\uB294, \uD574\uAC00 \uC0AC\uB9C9 \uB108\uBA38\uB85C \uB0B4\uB824\uAC00\uB294
    \uBAA8\uC2B5\uC744 \uC7A0\uC2DC \uB354 \uC9C0\uCF1C\uBD24\uB2E4."
  m_isRightToLeft: 0
