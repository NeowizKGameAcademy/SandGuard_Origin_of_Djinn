# Unity가 다시 만드는 캐시와 개인 설정
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# 빌드 결과
/[Bb]uild/
/[Bb]uilds/

# IDE 캐시와 Unity가 자동 생성하는 프로젝트 파일
/.vs/
/.idea/
/.vscode/
/*.csproj
/*.sln
/*.slnx
/*.sln.iml
/*.unityproj
/*.pidb
/*.booproj
/*.svd
/*.opendb
/*.VC.db
*.suo
*.user
*.userprefs

# Unity 진단 및 자동 생성 파일
/Assets/AssetStoreTools*
/Assets/StreamingAssets/aa/
/Assets/StreamingAssets/aa.meta
/Assets/AddressableAssetsData/*/addressables_content_state.bin
/Assets/AddressableAssetsData/*/addressables_content_state.bin.meta
/Assets/AddressableAssetsData/link.xml
/Assets/AddressableAssetsData/link.xml.meta
/Assets/AddressableAssetsData/AddressablesBuildTEP.json
/Assets/AddressableAssetsData/AddressablesBuildTEP.json.meta
/sysinfo.txt
/crash.dmp

# 운영체제와 편집기의 임시 파일
.DS_Store
Thumbs.db
Desktop.ini
*~
*.swp
*.swo
~$*

# Assets와 .meta, Packages, ProjectSettings, Docs는 저장소에 포함한다.
# 특히 Packages/packages-lock.json은 패키지 버전을 맞추기 위해 포함한다.

# 대용량 압축본 (GitHub 100MB 제한)
*.7z

# 대용량 영상 파일 (확장자 대소문자 모두 제외)
*.[mM][pP]4
*.[mM][oO][vV]
*.[mM][kK][vV]
*.[aA][vV][iI]
*.[wW][eE][bB][mM]
*.[wW][mM][vV]
*.[fF][lL][vV]
*.[mM]4[vV]
*.[mM][pP][gG]
*.[mM][pP][eE][gG]
*.[mM][tT][sS]
*.[mM]2[tT][sS]
*.3[gG][pP]
*.[oO][gG][vV]

# Blender 원본과 자동 백업 (게임에서 참조하지 않음)
*.[bB][lL][eE][nN][dD]
*.[bB][lL][eE][nN][dD][0-9]
